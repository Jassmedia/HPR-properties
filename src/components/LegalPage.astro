---
/** Structure for legal pages. Section bodies are drafts for review by HPR Properties' legal adviser. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  sections: { id: string; title: string; body: string[] }[];
}
const { title, description, sections } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageHero title={title} eyebrow="Legal" intro="Last updated: [date to be confirmed]" />
  <section class="section legal">
    <div class="container legal__inner">
      <nav class="legal__toc" aria-label="On this page">
        <p class="legal__toc-title">On this page</p>
        <ol>{sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}</ol>
      </nav>
      <div class="legal__body">
        {site.isDraft && (
          <p class="draft-note">Page structure only. Final wording must be provided or approved by HPR Properties' legal adviser before publication. Bracketed items need confirmation.</p>
        )}
        {sections.map((s, i) => (
          <section id={s.id}>
            <h2>{i + 1}. {s.title}</h2>
            {s.body.map((p) => <p>{p}</p>)}
          </section>
        ))}
        <section id="contact-us">
          <h2>{sections.length + 1}. Contact</h2>
          <p>Questions about this page can be sent to {site.name} at <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> or {site.contact.phoneDisplay}, {site.contact.office.lines.join(', ')}.</p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal__inner { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: start; }
  .legal__toc { position: sticky; top: calc(var(--header-h) + 1.5rem); font-size: var(--fs-sm); }
  .legal__toc-title { font-size: var(--fs-xs); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--c-muted); margin-bottom: 0.75rem; }
  .legal__toc ol { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.5rem; color: var(--c-muted); }
  .legal__toc a:hover { color: var(--c-ink); text-decoration: underline; }
  .legal__body { display: grid; gap: 2.25rem; max-width: 760px; }
  .legal__body section { display: grid; gap: 0.75rem; scroll-margin-top: calc(var(--header-h) + 1.5rem); }
  .legal__body h2 { font-size: 1.3rem; }
  .legal__body a { color: var(--c-teal-ink); text-decoration: underline; }
  @media (max-width: 860px) {
    .legal__inner { grid-template-columns: 1fr; }
    .legal__toc { position: static; padding: 1.25rem; background: var(--c-sand); border-radius: var(--radius); }
  }
</style>
