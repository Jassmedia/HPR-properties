---
/** Founder profile. While details are placeholders it renders only in draft mode — never publish the placeholder live. */
import Icon from './Icon.astro';
import { site } from '../data/site';
import { founder } from '../data/home';

interface Props { headingLevel?: 'h1' | 'h2'; showLink?: boolean }
const { headingLevel = 'h2', showLink = false } = Astro.props;
const Heading = headingLevel;
const visible = !founder.placeholder || site.isDraft;
---

{visible && (
  <section class="section founder" aria-labelledby="founder-title">
    <div class="container founder__inner">
      <div class="founder__photo reveal">
        {founder.photo ? (
          <img src={founder.photo} alt={`${founder.name}, ${founder.role}`} width="960" height="1200" loading="lazy" decoding="async" />
        ) : (
          <div class="founder__placeholder" role="img" aria-label="Founder photo placeholder">
            <Icon name="user" size={56} />
            <span>Approved photo to be supplied</span>
          </div>
        )}
      </div>
      <div class="founder__text reveal">
        <p class="eyebrow">Leadership</p>
        <Heading id="founder-title">Meet the Founder</Heading>
        <blockquote class="founder__quote">
          <Icon name="quote" size={28} />
          <p>{founder.message}</p>
        </blockquote>
        <p class="founder__name">{founder.name}</p>
        <p class="founder__role">{founder.role}</p>
        {founder.placeholder && (
          <p class="draft-note">Placeholder — founder details to be provided by HPR Properties. Not for publication.</p>
        )}
        {!founder.photo && site.isDraft && (
          <p class="draft-note">Founder photo pending — approved portrait to be added.</p>
        )}
        {showLink && <a href="/founder" class="link-arrow">Founder &amp; Team <Icon name="arrow" size={16} /></a>}
      </div>
    </div>
  </section>
)}

<style>
  .founder__inner { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2rem, 1rem + 5vw, 6rem); align-items: center; }
  .founder__photo img, .founder__placeholder { width: 100%; aspect-ratio: 4 / 5; border-radius: var(--radius-lg); object-fit: cover; object-position: top; }
  .founder__photo img { box-shadow: var(--shadow-lg); }
  .founder__placeholder {
    display: grid; place-content: center; justify-items: center; gap: 1rem; text-align: center;
    background: repeating-linear-gradient(135deg, var(--c-sand) 0 14px, var(--c-sand-2) 14px 28px);
    color: var(--c-muted); font-size: var(--fs-sm); border: 1px dashed #d4cfc5;
  }
  .founder__text { display: grid; gap: 1rem; justify-items: start; }
  .founder__text :is(h1, h2) { font-size: var(--fs-xl); }
  .founder__quote { margin: 0.5rem 0 0; display: grid; gap: 1rem; }
  .founder__quote :global(.icon) { color: var(--c-teal); }
  .founder__quote p { font-family: var(--font-display); font-size: var(--fs-lg); font-weight: 400; line-height: 1.5; color: var(--c-ink); letter-spacing: -0.01em; }
  .founder__name { margin-top: 0.5rem; font-family: var(--font-display); font-weight: 600; color: var(--c-ink); font-size: 1.1rem; }
  .founder__role { margin-top: -0.85rem; color: var(--c-muted); }
  @media (max-width: 820px) {
    .founder__inner { grid-template-columns: 1fr; }
    .founder__photo { max-width: 420px; }
  }
</style>
