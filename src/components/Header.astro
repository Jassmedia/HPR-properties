---
import Icon from './Icon.astro';
import { site, mainNav, whatsappLink } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const h = href.split('?')[0];
  return h === '/' ? path === '/' : path.startsWith(h);
};
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <img src="/images/hpr-logo.webp" alt="" width="48" height="48" class="brand__logo" />
      <span class="brand__text">
        <span class="brand__name">HPR Properties</span>
        <span class="brand__sub">Dubai</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        {mainNav.map((item) => (
          <li class={item.children ? 'nav__item has-sub' : 'nav__item'}>
            <a href={item.href} class="nav__link" aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && <Icon name="chevron" size={14} />}
            </a>
            {item.children && (
              <ul class="nav__sub">
                {item.children.map((c) => (
                  <li><a href={c.href}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href={site.contact.phoneHref} class="btn btn--ghost btn--sm header-call">
        <Icon name="phone" size={16} />
        <span class="header-call__label">Call</span>
      </a>
      <a href={whatsappLink('Hello HPR Properties, I would like to enquire about a property.')} class="btn btn--sm btn--whatsapp" target="_blank" rel="noopener">
        <Icon name="whatsapp" size={16} />
        <span>WhatsApp</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden">Open menu</span>
        <span class="menu-toggle__open"><Icon name="menu" size={24} /></span>
        <span class="menu-toggle__close"><Icon name="close" size={24} /></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav class="container" aria-label="Mobile">
      <ul class="mobile-menu__list">
        {mainNav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            {item.children && (
              <ul class="mobile-menu__sub">
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="mobile-menu__contact">
        <a href={site.contact.phoneHref} class="btn btn--ghost"><Icon name="phone" size={18} /> {site.contact.phoneDisplay}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.querySelector('.visually-hidden')!.textContent = open ? 'Open menu' : 'Close menu';
    if (menu) menu.hidden = open;
    document.body.classList.toggle('menu-open', !open);
  });

  // On pages whose sections are tagged with data-nav (the homepage), highlight the menu item
  // for the section currently in view instead of leaving "Home" highlighted all the way down.
  const sections = [...document.querySelectorAll<HTMLElement>('[data-nav]')];
  const topLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav__link, .mobile-menu__list > li > a')];
  let current = '';
  const spy = () => {
    if (!sections.length) return;
    const line = window.innerHeight * 0.4;
    let target = sections[0].dataset.nav!;
    for (const s of sections) {
      if (s.getBoundingClientRect().top <= line) target = s.dataset.nav!;
    }
    // At the very bottom of the page, the last section wins even if it is short.
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
      target = sections[sections.length - 1].dataset.nav!;
    }
    if (target === current) return;
    current = target;
    topLinks.forEach((a) => {
      if (a.getAttribute('href') === target) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  };

  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 8);
    spy();
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', spy, { passive: true });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  /* Blur lives on a pseudo-layer: backdrop-filter on the header itself would trap the fixed mobile menu inside it */
  .site-header::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: rgba(255, 255, 255, 0.94); backdrop-filter: saturate(160%) blur(12px);
  }
  :global(body.menu-open) { overflow: hidden; }
  .site-header.is-scrolled { border-color: var(--c-line); box-shadow: var(--shadow-sm); }
  .site-header__inner { display: flex; align-items: center; gap: 1.25rem; height: var(--header-h); }

  .brand { display: flex; align-items: center; gap: 0.75rem; flex: none; }
  .brand__logo { width: 48px; height: 48px; border-radius: 10px; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.06); }
  .brand__text { display: grid; line-height: 1.1; }
  .brand__name { font-family: var(--font-display); font-weight: 600; font-size: 1.08rem; color: var(--c-ink); letter-spacing: -0.01em; }
  .brand__sub { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--c-teal-ink); margin-top: 3px; }

  .nav { margin-inline: auto; }
  .nav__list { display: flex; align-items: center; gap: 0.15rem; }
  .nav__item { position: relative; }
  .nav__link {
    display: inline-flex; align-items: center; gap: 0.25rem;
    padding: 0.55rem 0.6rem; border-radius: 999px; white-space: nowrap;
    font-size: 0.9rem; font-weight: 500; color: var(--c-text);
    transition: color 0.2s, background-color 0.2s;
  }
  .nav__link:hover { color: var(--c-ink); background: var(--c-sand); }
  .nav__link[aria-current='page'] { color: var(--c-ink); }
  .nav__link[aria-current='page']::after {
    content: ''; position: absolute; left: 50%; bottom: 2px; width: 5px; height: 5px; margin-left: -2.5px;
    border-radius: 50%; background: var(--c-teal);
  }
  .nav__sub {
    position: absolute; top: calc(100% + 6px); left: 0; min-width: 220px;
    padding: 0.5rem; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius);
    box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }
  .nav__sub::before { content: ''; position: absolute; inset: -8px 0 auto; height: 8px; }
  .has-sub:hover .nav__sub, .has-sub:focus-within .nav__sub { opacity: 1; visibility: visible; transform: none; }
  .nav__sub a { display: block; padding: 0.55rem 0.8rem; border-radius: var(--radius-sm); font-size: 0.92rem; }
  .nav__sub a:hover { background: var(--c-sand); color: var(--c-ink); }

  .header-actions { display: flex; align-items: center; gap: 0.5rem; flex: none; }

  .menu-toggle {
    display: none; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%;
    background: transparent; color: var(--c-ink); cursor: pointer;
  }
  .menu-toggle__close { display: none; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__open { display: none; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__close { display: block; }

  .mobile-menu {
    position: fixed; inset: var(--header-h) 0 0; background: #fff; overflow-y: auto;
    border-top: 1px solid var(--c-line); padding-block: 1rem 6rem;
  }
  .mobile-menu__list > li { border-bottom: 1px solid var(--c-line); }
  .mobile-menu__list > li > a { display: block; padding: 1rem 0; font-family: var(--font-display); font-size: 1.15rem; font-weight: 500; color: var(--c-ink); }
  .mobile-menu__sub { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-bottom: 1rem; }
  .mobile-menu__sub a { display: inline-block; padding: 0.45rem 0.85rem; border-radius: 999px; background: var(--c-sand); font-size: 0.9rem; }
  .mobile-menu__contact { padding-top: 1.5rem; }
  .mobile-menu__contact .btn { width: 100%; }

  @media (max-width: 1380px) {
    .header-call { padding-inline: 0.7rem; }
    .header-call__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  }
  @media (max-width: 1180px) {
    .nav { display: none; }
    .menu-toggle { display: grid; }
    .header-actions { margin-left: auto; }
  }
  @media (max-width: 560px) {
    :global(:root) { --header-h: 68px; }
    .brand__logo { width: 42px; height: 42px; }
    .header-actions .btn { display: none; }
  }
</style>
