---
/**
 * Enquiry form. No backend is connected yet, so nothing is stored on this website:
 * on submit, the details are validated and handed to WhatsApp or the visitor's email app.
 * When a backend / CRM is approved, replace the submit handler with a POST to it.
 */
import Icon from './Icon.astro';
import { site } from '../data/site';
import { areas, enquiryTypes } from '../data/home';

interface Props {
  id?: string;
  title?: string;
  /** Pre-selected enquiry type value */
  enquiry?: string;
  /** Property context, e.g. "5 Bedroom Villa (Ref: HPR-S-002)" */
  property?: string;
  compact?: boolean;
}
const { id = 'enquiry', title, enquiry = '', property, compact = false } = Astro.props;
const types = enquiryTypes.filter((t) => t.value !== 'holiday-home' || site.features.holidayHomes);
const locations = areas.filter((a) => a.published).map((a) => a.name);
---

<form
  class:list={['eform', { 'eform--compact': compact }]}
  id={id}
  novalidate
  data-enquiry-form
  data-wa={site.contact.whatsappNumber}
  data-email={site.contact.email}
>
  {title && <h2 class="eform__title">{title}</h2>}
  {property && <input type="hidden" name="property" value={property} />}

  <div class="eform__grid">
    <div class="field">
      <label for={`${id}-name`}>Full name <span aria-hidden="true">*</span></label>
      <input id={`${id}-name`} name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for={`${id}-phone`}>Phone / WhatsApp <span aria-hidden="true">*</span></label>
      <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[+0-9 ()-]{7,}" />
    </div>
    <div class:list={['field', { 'field--full': compact }]}>
      <label for={`${id}-email`}>Email</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" />
    </div>
    {!property && (
      <div class="field">
        <label for={`${id}-type`}>Enquiry type <span aria-hidden="true">*</span></label>
        <select id={`${id}-type`} name="type" required data-enquiry-type>
          <option value="">Select…</option>
          {types.map((t) => <option value={t.value} selected={t.value === enquiry}>{t.label}</option>)}
        </select>
      </div>
    )}
    {!property && (
      <div class="field">
        <label for={`${id}-location`}>Preferred location</label>
        <select id={`${id}-location`} name="location">
          <option value="">Any / not sure</option>
          {locations.map((l) => <option value={l}>{l}</option>)}
          <option value="Other">Other</option>
        </select>
      </div>
    )}
    {!property && (
      <div class="field">
        <label for={`${id}-budget`}>Budget (AED, optional)</label>
        <input id={`${id}-budget`} name="budget" type="text" inputmode="numeric" placeholder="e.g. 1,500,000" />
      </div>
    )}
    {property && (
      <div class:list={['field', { 'field--full': compact }]}>
        <label for={`${id}-time`}>Preferred viewing time</label>
        <input id={`${id}-time`} name="time" type="text" placeholder="e.g. Saturday afternoon" />
      </div>
    )}
    <div class="field field--full">
      <label for={`${id}-message`}>Message</label>
      <textarea id={`${id}-message`} name="message" rows={compact ? 3 : 5}>{property ? `I'm interested in ${property}.` : ''}</textarea>
    </div>
  </div>

  <label class="eform__consent">
    <input type="checkbox" name="consent" required />
    <span>I agree to be contacted by HPR Properties about this enquiry and have read the <a href="/privacy-policy">Privacy Policy</a>. <span aria-hidden="true">*</span></span>
  </label>

  <p class="eform__error" role="alert" hidden data-error>Please complete the required fields marked *.</p>

  <div class="eform__actions">
    <button type="submit" class="btn" value="whatsapp"><Icon name="whatsapp" size={18} /> Send via WhatsApp</button>
    <button type="submit" class="btn btn--ghost" value="email"><Icon name="mail" size={18} /> Send via Email</button>
  </div>
  <p class="eform__note">
    Your details are not stored on this website — they are sent through WhatsApp or your email app. Our team will review your enquiry and respond using your preferred contact method.
  </p>
</form>

<script>
  const labels: Record<string, string> = {
    name: 'Name', phone: 'Phone', email: 'Email', type: 'Enquiry type', location: 'Preferred location',
    budget: 'Budget (AED)', property: 'Property', time: 'Preferred viewing time', message: 'Message',
  };

  document.querySelectorAll<HTMLFormElement>('[data-enquiry-form]').forEach((form) => {
    // Prefill enquiry type from ?enquiry=
    const pre = new URLSearchParams(location.search).get('enquiry');
    const typeSel = form.querySelector<HTMLSelectElement>('[data-enquiry-type]');
    if (pre && typeSel && [...typeSel.options].some((o) => o.value === pre)) typeSel.value = pre;

    const error = form.querySelector<HTMLElement>('[data-error]')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const via = (e.submitter as HTMLButtonElement | null)?.value || 'whatsapp';
      if (!form.checkValidity()) {
        error.hidden = false;
        form.querySelectorAll<HTMLInputElement>(':invalid').forEach((el) => el.setAttribute('aria-invalid', 'true'));
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      error.hidden = true;
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));

      const data = new FormData(form);
      const lines: string[] = [];
      for (const [k, v] of data.entries()) {
        if (k === 'consent' || !String(v).trim()) continue;
        const val = k === 'type' ? typeSel?.selectedOptions[0]?.text ?? v : v;
        lines.push(`${labels[k] ?? k}: ${val}`);
      }
      const body = `New enquiry from the HPR Properties website\n\n${lines.join('\n')}`;
      if (via === 'email') {
        const subject = `Website enquiry — ${data.get('property') || typeSel?.selectedOptions[0]?.text || 'General'}`;
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      } else {
        window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(body)}`, '_blank', 'noopener');
      }
    });
    form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute('aria-invalid'));
  });
</script>

<style>
  .eform { display: grid; gap: 1.25rem; }
  .eform__title { font-size: var(--fs-lg); }
  .eform__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 1.25rem; }
  .eform--compact .eform__grid { grid-template-columns: 1fr; }
  .field { display: grid; gap: 0.4rem; min-width: 0; }
  .field--full { grid-column: 1 / -1; }
  .field label { font-size: var(--fs-sm); font-weight: 500; color: var(--c-ink); }
  .field label span { color: var(--c-teal-ink); }
  .field input, .field select, .field textarea {
    width: 100%; min-height: 48px; padding: 0.7rem 0.9rem; border: 1px solid #d9d5cd; border-radius: var(--radius-sm);
    background: #fff; transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field textarea { resize: vertical; min-height: 110px; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--c-teal); box-shadow: 0 0 0 3px rgba(21, 151, 163, 0.18); }
  .field [aria-invalid='true'] { border-color: #c2412d; }
  .eform__consent { display: flex; gap: 0.7rem; align-items: flex-start; font-size: var(--fs-sm); color: var(--c-muted); }
  .eform__consent input { width: 18px; height: 18px; margin-top: 2px; flex: none; accent-color: var(--c-ink); }
  .eform__consent a { text-decoration: underline; color: var(--c-ink); }
  .eform__error { color: #b2361f; font-size: var(--fs-sm); font-weight: 500; }
  .eform__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .eform--compact .eform__actions .btn { flex: 1 1 100%; }
  .eform__note { font-size: 0.8rem; color: var(--c-muted); }
  @media (max-width: 640px) {
    .eform__grid { grid-template-columns: 1fr; }
    .eform__actions .btn { flex: 1 1 100%; }
  }
</style>
