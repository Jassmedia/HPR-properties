---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site, photo } from '../data/site';
import { areas } from '../data/home';
import { properties } from '../data/properties';

const shown = areas.filter((a) => a.published).map((a) => ({
  ...a,
  count: properties.filter((p) => p.area === a.name).length,
}));
---

<BaseLayout
  title="Dubai Areas"
  description="Explore properties by location in Dubai, including Dubai Marina, Downtown Dubai, Palm Jumeirah, Business Bay and Jumeirah Village Circle."
>
  <PageHero
    title="Explore Dubai Areas"
    eyebrow="Locations"
    intro="Discover properties by community. Choose an area to see current listings available through HPR Properties."
    image="1526495124232-a04e1849168c"
  />

  <section class="section">
    <div class="container">
      {site.isDraft && (
        <p class="draft-note areas-note">Areas shown are those suggested in the content brief. HPR Properties to confirm which locations to feature; listing counts currently reflect sample listings.</p>
      )}
      <ul class="area-list">
        {shown.map((a, i) => (
          <li class="reveal" style={`transition-delay:${i * 60}ms`}>
            <article class="area">
              <a href={`/properties?location=${encodeURIComponent(a.name)}`} class="area__media" tabindex="-1" aria-hidden="true">
                <img src={photo(a.image, 900, 640)} alt="" width="900" height="640" loading="lazy" decoding="async" />
              </a>
              <div class="area__body">
                <h2><a href={`/properties?location=${encodeURIComponent(a.name)}`}>{a.name}</a></h2>
                <p>{a.blurb}</p>
                <ul class="area__types" aria-label="Property types">
                  {a.types.map((t) => <li>{t}</li>)}
                </ul>
                <div class="area__foot">
                  <span class="area__count">{a.count} {a.count === 1 ? 'listing' : 'listings'}</span>
                  <a href={`/properties?location=${encodeURIComponent(a.name)}`} class="link-arrow">View properties <Icon name="arrow" size={16} /></a>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title="Looking in a different area?" text="Tell us where you'd like to live or invest, and our team will share relevant options." />
</BaseLayout>

<style>
  .areas-note { margin-bottom: 2rem; }
  .area-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .area { display: grid; grid-template-rows: auto 1fr; height: 100%; border: 1px solid var(--c-line); border-radius: var(--radius-lg); overflow: hidden; background: #fff; transition: box-shadow .35s var(--ease), transform .35s var(--ease); }
  .area:hover { box-shadow: var(--shadow-lg); transform: translateY(-3px); }
  .area__media { display: block; aspect-ratio: 16 / 9; overflow: hidden; }
  .area__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .area:hover .area__media img { transform: scale(1.05); }
  .area__body { display: grid; gap: 0.8rem; align-content: start; padding: 1.6rem 1.75rem 1.5rem; }
  .area__body h2 { font-size: 1.5rem; font-weight: 500; }
  .area__body h2 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .area__body > p { color: var(--c-muted); }
  .area__types { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .area__types li { padding: 0.3rem 0.7rem; border-radius: 999px; background: var(--c-sand); font-size: var(--fs-sm); }
  .area__foot { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 0.5rem; padding-top: 1rem; border-top: 1px solid var(--c-line); }
  .area__count { font-size: var(--fs-sm); color: var(--c-muted); }
  @media (max-width: 760px) { .area-list { grid-template-columns: 1fr; } }
</style>
