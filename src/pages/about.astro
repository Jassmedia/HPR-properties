---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FounderBlock from '../components/FounderBlock.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { photo } from '../data/site';
import { whyChoose } from '../data/home';

const values = [
  { title: 'Trust', text: 'Building relationships on honest, reliable guidance.' },
  { title: 'Transparency', text: 'Sharing clear information about properties, pricing and next steps.' },
  { title: 'Professionalism', text: 'Communicating clearly and handling every enquiry with care.' },
  { title: 'Responsiveness', text: 'Reviewing enquiries promptly and keeping clients informed.' },
  { title: 'Client care', text: 'Listening carefully and focusing on what each client needs.' },
];
---

<BaseLayout
  title="About Us"
  description="HPR Properties helps individuals, families and investors explore property opportunities in Dubai with clear information and personalised guidance."
>
  <PageHero
    title="About HPR Properties"
    eyebrow="Your Trusted Real Estate Partner in Dubai"
    intro="At HPR Properties, we believe finding the right property begins with understanding the client."
    image="1582672060674-bc2bd808a8b5"
  />

  <section class="section" id="who-we-are">
    <div class="container story">
      <div class="story__text reveal">
        <p class="eyebrow">Who we are</p>
        <h2>Clear information and personalised guidance</h2>
        <p>
          We help individuals, families, and investors explore property opportunities in Dubai with clear information and personalised guidance.
        </p>
        <p>
          From residential apartments and villas to selected off-plan developments and rental opportunities, our aim is to make the property search simple, organised, and convenient. We focus on understanding each client's requirements, presenting relevant options, and helping them take informed next steps.
        </p>
        <p>
          Our approach is built on professional communication, transparency, and long-term client relationships. Clients should review property details carefully and confirm pricing, availability, fees, and transaction requirements before making a decision.
        </p>
      </div>
      <div class="story__media reveal">
        <img src={photo('1600607687939-ce8a6c25118c', 900, 1100)} alt="Bright, modern living room with floor-to-ceiling windows" width="900" height="1100" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="mv" id="mission-vision">
        <article class="mv__card reveal">
          <span class="mv__icon"><Icon name="compass" size={24} /></span>
          <p class="eyebrow">Our Mission</p>
          <h2>To help clients make confident, well-informed property decisions.</h2>
        </article>
        <article class="mv__card mv__card--dark reveal on-dark">
          <span class="mv__icon"><Icon name="chart" size={24} /></span>
          <p class="eyebrow">Our Vision</p>
          <h2>To build lasting relationships and become a trusted name in real estate.</h2>
        </article>
      </div>

      <div class="values" id="values">
        <div class="heading reveal">
          <p class="eyebrow">Our Values</p>
          <h2>What guides our work</h2>
        </div>
        <ol class="values__list">
          {values.map((v, i) => (
            <li class="reveal" style={`transition-delay:${i * 60}ms`}>
              <span class="values__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="heading heading--center reveal">
        <p class="eyebrow">Our approach</p>
        <h2>How we support clients</h2>
      </div>
      <ul class="approach">
        {whyChoose.map((w) => (
          <li class="reveal">
            <span class="approach__icon"><Icon name={w.icon} size={22} /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="section--sand"><FounderBlock showLink /></div>

  <CtaBand />
</BaseLayout>

<style>
  .story { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 1rem + 5vw, 6rem); align-items: center; }
  .story__text { display: grid; gap: 1.1rem; }
  .story__text h2 { font-size: var(--fs-xl); margin-bottom: 0.25rem; }
  .story__text p:not(.eyebrow) { font-size: 1.05rem; }
  .story__media img { width: 100%; aspect-ratio: 9 / 11; object-fit: cover; border-radius: var(--radius-lg); }

  .mv { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .mv__card { display: grid; gap: 0.9rem; align-content: start; padding: clamp(2rem, 1.5rem + 2vw, 3.25rem); border-radius: var(--radius-lg); background: #fff; }
  .mv__card h2 { font-size: var(--fs-lg); font-weight: 500; line-height: 1.35; }
  .mv__card--dark { background: var(--c-ink); }
  .mv__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--c-teal-soft); color: var(--c-teal-ink); margin-bottom: 0.5rem; }
  .mv__card--dark .mv__icon { background: rgba(21,151,163,.18); color: #7fd0d7; }

  .mv, .values { scroll-margin-top: calc(var(--header-h) + 2rem); }
  .values { margin-top: clamp(3.5rem, 2.5rem + 4vw, 6rem); }
  .values__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; }
  .values__list li { display: grid; gap: 0.5rem; align-content: start; padding-top: 1.25rem; border-top: 2px solid var(--c-ink); }
  .values__num { font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 600; color: var(--c-teal-ink); }
  .values__list h3 { font-size: 1.15rem; font-weight: 500; }
  .values__list p { color: var(--c-muted); font-size: 0.95rem; }

  .approach { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .approach li { display: grid; gap: 0.6rem; align-content: start; padding: 2rem 1.6rem; border: 1px solid var(--c-line); border-radius: var(--radius-lg); }
  .approach__icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: var(--c-teal-soft); color: var(--c-teal-ink); margin-bottom: 0.4rem; }
  .approach h3 { font-size: 1.1rem; font-weight: 500; }
  .approach p { color: var(--c-muted); }

  @media (max-width: 1080px) {
    .values__list { grid-template-columns: repeat(3, 1fr); }
    .approach { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 820px) {
    .story, .mv { grid-template-columns: 1fr; }
    .story__media { order: -1; }
    .story__media img { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 560px) {
    .values__list, .approach { grid-template-columns: 1fr; }
  }
</style>
