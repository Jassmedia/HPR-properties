---
/**
 * Airbnb / Holiday Homes — prepared but UNPUBLISHED.
 * While site.features.holidayHomes is false this route redirects to /services and is not linked anywhere.
 * Enable only after HPR Properties confirms the service and applicable Dubai holiday-home approvals.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

if (!site.features.holidayHomes) return Astro.redirect('/services');

// Include only the services HPR actually provides.
const offered = [
  'Property suitability and short-term rental enquiry support.',
  'Listing preparation, photography coordination, and description support.',
  'Guest enquiry and communication support.',
  'Check-in / check-out coordination.',
  'Cleaning, linen, and maintenance coordination.',
  'Owner updates and booking / performance reporting, if included.',
  'Consultation on costs, occupancy assumptions, platform fees, and operating expenses.',
];
---

<BaseLayout title="Airbnb & Holiday Home Solutions in Dubai" description="Holiday-home and short-term rental support for property owners in Dubai.">
  <PageHero
    title="Airbnb & Holiday Home Solutions in Dubai"
    eyebrow="Holiday homes"
    intro="Thinking about short-term rentals in Dubai? HPR Properties can help you understand available holiday-home options and discuss suitable support based on your property and requirements."
    image="1613490493576-7fde63acd811"
  />
  <section class="section">
    <div class="container hh">
      <div>
        <h2>How we can help</h2>
        <ul class="hh__list">{offered.map((o) => <li><Icon name="arrow" size={16} /> {o}</li>)}</ul>
        <p class="hh__notice">
          Holiday-home operations may require permits, registrations, and compliance with Dubai rules. Eligibility, permissions, costs, occupancy and revenue assumptions should be verified. Income and occupancy are not guaranteed.
        </p>
      </div>
      <div><h2>Owner enquiry</h2><EnquiryForm id="hh-form" enquiry="holiday-home" /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .hh { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: start; }
  .hh h2 { font-size: var(--fs-lg); margin-bottom: 1.25rem; }
  .hh__list { display: grid; gap: 0.85rem; }
  .hh__list li { display: flex; gap: 0.6rem; align-items: baseline; }
  .hh__list :global(.icon) { color: var(--c-teal); flex: none; transform: translateY(3px); }
  .hh__notice { margin-top: 2rem; padding: 1rem 1.25rem; border-left: 3px solid var(--c-yellow); background: var(--c-sand); font-size: var(--fs-sm); }
  @media (max-width: 860px) { .hh { grid-template-columns: 1fr; } }
</style>
