---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="nf">
    <div class="container nf__inner">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page</h1>
      <p>The page may have moved, or the property may no longer be listed.</p>
      <div class="nf__actions">
        <a href="/properties" class="btn">Browse Properties <Icon name="arrow" size={18} /></a>
        <a href="/" class="btn btn--ghost">Back to Home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { padding-block: clamp(5rem, 4rem + 8vw, 10rem); background: var(--c-sand); }
  .nf__inner { display: grid; gap: 1.1rem; justify-items: start; max-width: 680px; }
  .nf h1 { font-size: var(--fs-xl); }
  .nf p:not(.eyebrow) { color: var(--c-muted); font-size: var(--fs-md); }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
</style>
